      "$ref": "command_receipt_v1.schema.json"
    },
    "current_canonical_state": {
      "anyOf": [
        {
          "$ref": "current_canonical_state_v1.schema.json"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false
}
