{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scoring_key_v1.schema.json",
  "title": "scoring_key",
  "type": "object",
  "required": [
    "activity_revision_id",
    "scoring_version_id",
    "policy_version",
    "keys"
  ],
  "properties": {
    "activity_revision_id": {
      "type": "string",
      "format": "uuid"
    },
    "scoring_version_id": {
      "type": "string",
      "format": "uuid"
    },
    "policy_version": {
      "const": "completion_policy_v1"
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "title": "key",
        "type": "object",
        "required": [
          "question_revision_id",
          "correct_option_id"
        ],
        "properties": {
          "question_revision_id": {
            "type": "string",
            "format": "uuid"
          },
          "correct_option_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "maxItems": 100
    }
  },
  "additionalProperties": false
}
