{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stored_event_v1.schema.json",
  "title": "ClientEventV1",
  "type": "object",
  "required": [
    "event_id",
    "event_name",
    "event_version",
    "occurred_at",
    "context",
    "payload",
    "learner_id",
    "received_at",
    "source",
    "clock_quality",
    "payload_digest"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,63}$"
    },
    "event_version": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "device_sequence": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "context": {
      "type": "object",
      "properties": {
        "enrollment_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "course_release_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "activity_revision_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "attempt_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "decision_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "media_resource_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "payload": {
      "type": "object"
    },
    "learner_id": {
      "type": "string",
      "format": "uuid"
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "enum": [
        "flutter_android",
        "flutter_web",
        "server"
      ]
    },
    "clock_quality": {
      "enum": [
        "normal",
        "skewed",
        "unknown"
      ]
    },
    "payload_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
