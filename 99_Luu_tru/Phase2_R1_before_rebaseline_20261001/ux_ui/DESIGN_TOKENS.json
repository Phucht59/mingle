{
  "meta": {
    "name": "Mingo UX Reference Theme",
    "version": "0.1",
    "brand_lock": false,
    "note": "Implementation-ready UX theme; visual brand may evolve without changing semantic token names."
  },
  "color": {
    "canvas": "#F6F8FC",
    "surface": "#FFFFFF",
    "surface_subtle": "#EEF2F7",
    "text": "#0F172A",
    "text_muted": "#475569",
    "border": "#CBD5E1",
    "primary": "#3046C5",
    "primary_hover": "#2438A8",
    "primary_soft": "#E8ECFF",
    "accent": "#0F766E",
    "accent_soft": "#CCFBF1",
    "success": "#166534",
    "success_soft": "#DCFCE7",
    "warning": "#92400E",
    "warning_soft": "#FEF3C7",
    "danger": "#B91C1C",
    "danger_soft": "#FEE2E2",
    "info": "#1D4ED8",
    "info_soft": "#DBEAFE",
    "focus": "#7C3AED"
  },
  "typography": {
    "family": "system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
    "sizes": {
      "caption": 12,
      "body_sm": 14,
      "body": 16,
      "title_sm": 20,
      "title": 24,
      "display": 32
    },
    "line_height": {
      "tight": 1.25,
      "normal": 1.5,
      "relaxed": 1.65
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    }
  },
  "spacing": {
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64
  },
  "radius": {
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "pill": 999
  },
  "shadow": {
    "card": "0 6px 18px rgba(15,23,42,.08)",
    "overlay": "0 18px 48px rgba(15,23,42,.18)"
  },
  "motion": {
    "fast_ms": 120,
    "normal_ms": 180,
    "slow_ms": 240,
    "reduced_motion": "disable non-essential transform/scroll animation"
  },
  "layout": {
    "learner_content_max_px": 560,
    "staff_content_max_px": 1440,
    "staff_sidebar_px": 248,
    "touch_target_min_dp": 48
  },
  "breakpoints_px": {
    "learner_small": 360,
    "learner_large": 480,
    "staff_tablet_fallback": 768,
    "staff_compact": 1024,
    "staff_wide": 1280
  }
}