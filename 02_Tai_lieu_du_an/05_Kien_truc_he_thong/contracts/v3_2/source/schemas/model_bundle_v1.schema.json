{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model_bundle_v1.schema.json",
  "title": "ModelBundleV1",
  "type": "object",
  "required": [
    "bundle_id",
    "model_version",
    "model_artifact_sha256",
    "feature_schema_version",
    "feature_schema_sha256",
    "preprocessing_artifact_sha256",
    "target_version",
    "horizon_version",
    "threshold",
    "uncertainty",
    "runtime",
    "validation_record",
    "release_status",
    "artifact_refs"
  ],
  "properties": {
    "bundle_id": {
      "type": "string",
      "format": "uuid"
    },
    "model_version": {
      "type": "string",
      "minLength": 1
    },
    "model_artifact_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "feature_schema_version": {
      "type": "string",
      "minLength": 1
    },
    "feature_schema_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "preprocessing_artifact_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "target_version": {
      "type": "string",
      "minLength": 1
    },
    "horizon_version": {
      "type": "string",
      "minLength": 1
    },
    "calibration": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "method",
            "version"
          ],
          "properties": {
            "method": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "threshold": {
      "type": "object",
      "required": [
        "version",
        "value"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "uncertainty": {
      "type": "object",
      "required": [
        "method",
        "version"
      ],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": [
        "python",
        "framework",
        "framework_version"
      ],
      "properties": {
        "python": {
          "type": "string",
          "minLength": 1
        },
        "framework": {
          "type": "string",
          "minLength": 1
        },
        "framework_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "validation_record": {
      "type": "object",
      "required": [
        "validation_id",
        "sha256"
      ],
      "properties": {
        "validation_id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "release_status": {
      "enum": [
        "candidate",
        "shadow",
        "staff_only",
        "controlled",
        "production",
        "retired"
      ]
    },
    "artifact_refs": {
      "title": "artifact_refs",
      "type": "object",
      "required": [
        "model",
        "preprocessing",
        "feature_schema",
        "validation",
        "target",
        "horizon"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "preprocessing": {
          "type": "string",
          "minLength": 1
        },
        "feature_schema": {
          "type": "string",
          "minLength": 1
        },
        "validation": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "horizon": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
