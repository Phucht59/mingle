{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source_capture_v1.schema.json",
  "title": "SourceCaptureV1",
  "type": "object",
  "required": [
    "source_capture_id",
    "learner_id",
    "enrollment_id",
    "serving_mode",
    "event_cutoff_at",
    "knowledge_cutoff_at",
    "evidence_manifest",
    "state_revisions",
    "manifest_sha256",
    "source_count",
    "generated_at",
    "capture_started_at",
    "state_evidence_publication_ids",
    "source_revision"
  ],
  "properties": {
    "source_capture_id": {
      "type": "string",
      "format": "uuid"
    },
    "learner_id": {
      "type": "string",
      "format": "uuid"
    },
    "enrollment_id": {
      "type": "string",
      "format": "uuid"
    },
    "serving_mode": {
      "enum": [
        "serving",
        "research_restatement"
      ]
    },
    "event_cutoff_at": {
      "type": "string",
      "format": "date-time"
    },
    "knowledge_cutoff_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_manifest": {
      "type": "object",
      "required": [
        "storage_ref",
        "sha256"
      ],
      "properties": {
        "storage_ref": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "state_revisions": {
      "type": "object",
      "required": [
        "progress_revision",
        "content_release_id"
      ],
      "properties": {
        "progress_revision": {
          "type": "integer",
          "minimum": 0
        },
        "profile_revision": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "content_release_id": {
          "type": "string",
          "format": "uuid"
        },
        "scoring_revision_watermark": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_count": {
      "type": "integer",
      "minimum": 0
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "capture_started_at": {
      "type": "string",
      "format": "date-time"
    },
    "state_evidence_publication_ids": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "source_revision": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false
}
