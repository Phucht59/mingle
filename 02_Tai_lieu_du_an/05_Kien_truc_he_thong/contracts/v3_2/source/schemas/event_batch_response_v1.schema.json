{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event_batch_response_v1.schema.json",
  "title": "event_batch_response",
  "type": "object",
  "required": [
    "results"
  ],
  "properties": {
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "title": "event_result",
        "type": "object",
        "required": [
          "event_id",
          "status",
          "reason_code",
          "retry_same_event"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "enum": [
              "accepted",
              "duplicate",
              "rejected",
              "retryable"
            ]
          },
          "reason_code": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "retry_same_event": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "maxItems": 100
    }
  },
  "additionalProperties": false
}
