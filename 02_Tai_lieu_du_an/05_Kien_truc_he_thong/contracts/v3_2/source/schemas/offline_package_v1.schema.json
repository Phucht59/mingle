{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "offline_package_v1.schema.json",
  "title": "offline_package",
  "type": "object",
  "required": [
    "package_id",
    "grant_id",
    "course_release_id",
    "release_manifest_sha256",
    "resource_ids",
    "package_sha256"
  ],
  "properties": {
    "package_id": {
      "type": "string",
      "format": "uuid"
    },
    "grant_id": {
      "type": "string",
      "format": "uuid"
    },
    "course_release_id": {
      "type": "string",
      "format": "uuid"
    },
    "release_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "resource_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "package_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
