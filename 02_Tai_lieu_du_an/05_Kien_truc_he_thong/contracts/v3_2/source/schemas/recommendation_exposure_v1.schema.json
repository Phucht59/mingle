{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "recommendation_exposure_v1.schema.json",
  "title": "RecommendationExposureV1",
  "type": "object",
  "required": [
    "exposure_id",
    "decision_id",
    "surface",
    "exposed_at"
  ],
  "properties": {
    "exposure_id": {
      "type": "string",
      "format": "uuid"
    },
    "decision_id": {
      "type": "string",
      "format": "uuid"
    },
    "surface": {
      "type": "string",
      "minLength": 1
    },
    "exposed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
