{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prediction_v1.schema.json",
  "title": "PredictionV1",
  "type": "object",
  "required": [
    "prediction_id",
    "status",
    "feature_snapshot_id",
    "generated_at",
    "as_of_at"
  ],
  "properties": {
    "prediction_id": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "enum": [
        "available",
        "insufficient_data",
        "model_unavailable",
        "schema_mismatch",
        "out_of_scope",
        "expired"
      ]
    },
    "feature_snapshot_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "model_bundle_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "model_bundle_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "target_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "horizon_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "probability": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "threshold_value": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "threshold_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "label": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "margin": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "margin_definition": {
      "type": [
        "string",
        "null"
      ]
    },
    "uncertainty_value": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "uncertainty_method": {
      "type": [
        "string",
        "null"
      ]
    },
    "uncertainty_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "calibration_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "as_of_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "available"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "model_bundle_id",
          "model_bundle_sha256",
          "target_version",
          "horizon_version",
          "probability",
          "threshold_value",
          "threshold_version",
          "label",
          "margin",
          "margin_definition",
          "uncertainty_value",
          "uncertainty_method",
          "uncertainty_version",
          "feature_snapshot_id"
        ],
        "properties": {
          "model_bundle_id": {
            "type": "string",
            "format": "uuid"
          },
          "model_bundle_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "target_version": {
            "type": "string",
            "minLength": 1
          },
          "horizon_version": {
            "type": "string",
            "minLength": 1
          },
          "probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "threshold_value": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "threshold_version": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "boolean"
          },
          "margin": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "margin_definition": {
            "const": "abs(probability-threshold_value)"
          },
          "uncertainty_value": {
            "type": "number",
            "minimum": 0
          },
          "uncertainty_method": {
            "type": "string",
            "minLength": 1
          },
          "uncertainty_version": {
            "type": "string",
            "minLength": 1
          },
          "feature_snapshot_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "else": {
        "properties": {
          "probability": {
            "type": "null"
          },
          "threshold_value": {
            "type": "null"
          },
          "threshold_version": {
            "type": "null"
          },
          "label": {
            "type": "null"
          },
          "margin": {
            "type": "null"
          },
          "margin_definition": {
            "type": "null"
          },
          "uncertainty_value": {
            "type": "null"
          },
          "uncertainty_method": {
            "type": "null"
          },
          "uncertainty_version": {
            "type": "null"
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
